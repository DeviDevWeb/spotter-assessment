DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Routing (OSRM) and geocoding (Nominatim), neither needs an API key. Weather is fetched by the browser
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
HTTP_USER_AGENT=weather-aware-truck-routing/0.1

# Postgres, leave POSTGRES_DB empty to use sqlite locally. docker compose sets these itself
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
